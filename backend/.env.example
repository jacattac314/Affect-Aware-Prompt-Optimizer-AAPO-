# LLM Provider — openai | anthropic | gemini
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional)
GEMINI_API_KEY=...

# Server
PORT=4000

# CORS — comma-separated origins, e.g. http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000
